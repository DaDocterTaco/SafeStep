{
  "name": "safestep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "contracts": "npm run build -w @safestep/contracts",
    "typecheck": "npm run contracts && npm run typecheck -w @safestep/extension && npm run typecheck -w @safestep/api",
    "build": "npm run contracts && npm run build -w @safestep/api && npm run build -w @safestep/extension",
    "dev": "npm run contracts && npm run dev -w @safestep/extension",
    "api": "npm run contracts && npm run build -w @safestep/api && npm start -w @safestep/api",
    "api:with-model": "npm run contracts && npm run build -w @safestep/api && npm run start:with-model -w @safestep/api",
    "fixture": "node tests/fixtures/serve.mjs",
    "test": "npm run contracts && tsx --test tests/*.test.ts",
    "test:chrome": "node tests/chrome.mjs",
    "test:chrome:f03": "node tests/chrome-f03.mjs",
    "release:stage1": "node scripts/stage1.mjs",
    "release:stage2": "node scripts/stage1.mjs 2",
    "release:stage3": "node scripts/stage1.mjs 3",
    "release:stage4": "node scripts/stage1.mjs 4",
    "release:stage5": "node scripts/stage1.mjs 5",
    "test:chrome:stage5": "node tests/chrome-stage5.mjs",
    "test:chrome:stage4": "node tests/chrome-stage4.mjs",
    "test:chrome:repairs": "node tests/chrome-repairs.mjs",
    "test:chrome:stage3": "node tests/chrome-stage3.mjs",
    "test:chrome:stage2": "node tests/chrome-stage2.mjs",
    "release:stage6": "node scripts/stage1.mjs 6",
    "release:stage7": "node scripts/stage1.mjs 7",
    "release:stage8": "node scripts/stage1.mjs 8",
    "test:chrome:stage8": "node tests/chrome-stage8.mjs",
    "test:chrome:stage7": "node tests/chrome-stage7.mjs",
    "test:chrome:stage7:guidance": "node tests/chrome-stage7-guidance.mjs",
    "test:chrome:stage7:policy": "node tests/chrome-stage7-guidance-policy.mjs",
    "test:chrome:stage7:protection": "node tests/chrome-stage7-protection.mjs",
    "test:chrome:stage7:explanations": "node tests/chrome-stage7-explanations.mjs",
    "test:chrome:stage6-repairs": "node tests/chrome-stage6-repairs.mjs",
    "test:chrome:stage6": "node tests/chrome-stage6.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "puppeteer-core": "25.16.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
