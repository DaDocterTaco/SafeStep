# Server-side Gemini settings for explanations, goal interpretation and next-step selection.
# Select a structured-output model available under your project. The extension uses a pairing token.
GEMINI_API_KEY=
GEMINI_MODEL=
# Google Web Risk has a separate server credential and operator opt-in. Enable only
# after confirming project API access, restricted key, quota and display rights.
# With that authorization, set the flag to true. The initial preflight daily
# cap is 1–20 (default 12). A larger automatic profile needs explicit approval
# and a budget migration. These environment values cannot raise existing caps.
# Build the API, then from apps/api initialize the shared per-user budget exactly once:
# node --env-file-if-exists=.env dist/server.js --init-web-risk-budget
# To run the paired service with this configuration and Gemini off:
# node --env-file-if-exists=.env dist/server.js
# V2 preserves UTC minute/day/month admissions, concurrency leases and 429 backoff.
# A lost journal disables dispatch. Restore its backup; never delete it to reset usage.
# See docs/automatic-web-risk-setup.md for existing journals and the single paired
# guarded Gemini + Web Risk runtime. Provider keys must be separate.
WEB_RISK_API_KEY=
SAFESTEP_WEB_RISK_AUTHORIZED=
SAFESTEP_WEB_RISK_DAILY_LIMIT=
TRUSTPILOT_API_KEY=
MARKETPLACE_SELLER_TOKEN=
PRODUCT_REVIEWS_TOKEN=
MARKETPLACE_BROWSE_TOKEN=
